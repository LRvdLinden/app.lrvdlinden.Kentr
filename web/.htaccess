ErrorDocument 404 /404.html
Options -Indexes

# Eén domeinvariant: altijd https://kent.lrvdlinden.app (301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # http -> https (ook achter een proxy/CDN die X-Forwarded-Proto zet)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^kent\.lrvdlinden\.app$ [NC]
  RewriteRule ^ https://kent.lrvdlinden.app%{REQUEST_URI} [R=301,L]
  # www -> kent.lrvdlinden.app
  RewriteCond %{HTTP_HOST} ^www\.kent\.lrvdlinden\.app$ [NC]
  RewriteRule ^ https://kent.lrvdlinden.app%{REQUEST_URI} [R=301,L]
  # /index.html -> map-URL (canonical)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddDefaultCharset utf-8

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml application/json application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
